    {
      "name": "02 Booking lifecycle",
      "item": [
        {
          "name": "Create booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rand = n => Math.floor(Math.random() * n);",
                  "pm.collectionVariables.set('firstname', 'Test' + (1000 + rand(9000)));",
                  "pm.collectionVariables.set('lastname', 'Guest' + (1000 + rand(9000)));",
                  "pm.collectionVariables.set('totalprice', 50 + rand(950));",
                  "const d = new Date(); d.setDate(d.getDate() + 30);",
                  "const out = new Date(d); out.setDate(out.getDate() + 3);",
                  "pm.collectionVariables.set('checkin', d.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('checkout', out.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Booking id returned', () => pm.expect(json.bookingid).to.be.a('number').above(0));",
                  "pm.test('Echoes request data', () => {",
                  "  pm.expect(json.booking.firstname).to.eql(pm.collectionVariables.get('firstname'));",
                  "  pm.expect(json.booking.lastname).to.eql(pm.collectionVariables.get('lastname'));",
                  "  pm.expect(json.booking.totalprice).to.eql(Number(pm.collectionVariables.get('totalprice')));",
                  "});",
                  "pm.collectionVariables.set('bookingId', json.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": {{totalprice}},\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}"
            }
          }
        },
        {
          "name": "Get booking by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'],",
                  "  properties: {",
                  "    firstname: { type: 'string' }, lastname: { type: 'string' },",
                  "    totalprice: { type: 'integer' }, depositpaid: { type: 'boolean' },",
                  "    bookingdates: { type: 'object', required: ['checkin', 'checkout'] }",
                  "  }",
                  "};",
                  "pm.test('Matches booking schema', () => pm.response.to.have.jsonSchema(schema));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Filter bookings by name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().map(b => b.bookingid);",
                  "pm.test('Created booking is in results', () => pm.expect(ids).to.include(Number(pm.collectionVariables.get('bookingId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname={{firstname}}&lastname={{lastname}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "{{firstname}}"
                },
                {
                  "key": "lastname",
                  "value": "{{lastname}}"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Update booking (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Price updated', () => pm.expect(pm.response.json().totalprice).to.eql(999));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": 999,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Late checkout\"\n}"
            }
          }
        },
        {
          "name": "Partial update (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Field changed', () => pm.expect(json.additionalneeds).to.eql('Airport pickup'));",
                  "pm.test('Other fields kept', () => pm.expect(json.totalprice).to.eql(999));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"additionalneeds\": \"Airport pickup\"\n}"
            }
          }
        }
      ]
